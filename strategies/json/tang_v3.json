{
  "name": "Tang v3",
  "version": "0.4",
  "description": "v3 基础 + 多周期冲突处理 / 假突破过滤 / 盘中单向与震荡执行细则 / 分批止盈纪律",

  "trend": {
    "method": "relaxed",
    "timeframe": "5m",
    "description": "MA10 vs MA50 方向 + MA10 斜率 (3-bar lookback)",
    "fast_ma": "m10",
    "slow_ma": "m50",
    "slope_bars": 3
  },

  "multi_timeframe": {
    "primary_bias_tf": "5m",
    "execution_tf": "1m",
    "higher_tf_priority": true,
    "conflict_policy": "follow_higher_tf_or_skip",
    "avoid_conflicting_segment": true,
    "no_countertrend_trade_when_5m_trending": true,
    "wait_additional_confirmation_bars_min": 1,
    "wait_additional_confirmation_bars_max": 2,
    "description": "当 5m 与 1m 冲突时，优先服从更大级别；若无法统一，直接避开。5m 顺势中，5m 本身也不做反手。"
  },

  "level_inertia": {
    "_comment": "默认把支撑/阻力当作有惯性的区域，而不是一个会被轻易一次性穿透的点。",
    "above_support_bias": "assume_hold_until_proven_break",
    "below_resistance_bias": "assume_reject_until_proven_break",
    "initial_break_bias": "most_breaks_fail_first",
    "breakout_success": {
      "require_full_body_open_and_close_beyond_level": true,
      "require_momentum_alignment": true,
      "retest_confirmation_preferred": true,
      "wick_only_cross_counts_as_break": false
    },
    "buffer_and_reclaim": {
      "use_range_as_buffer": true,
      "failed_break_reclaim_window_minutes_min": 3,
      "failed_break_reclaim_window_minutes_max": 5
    },
    "description": "只有当某根实体柱子完整开/收在线的另一侧，再结合动能，最好配合一次回测，才视为突破成功。"
  },

  "signals": [
    {
      "id": "reject_ma10",
      "name": "Reject MA10",
      "direction": "bearish",
      "style": "red",
      "anchor_side": "top",
      "conditions": {
        "candle_color": "green",
        "wick_touch": { "field": "hH", "operator": ">=", "target": "m10" },
        "body_below_1": { "field": "hC", "operator": "<=", "target": "m10" },
        "body_below_2": { "field": "hO", "operator": "<=", "target": "m10" }
      },
      "confirm": { "next_bar_color": "red" },
      "trend_required": "bearish"
    },
    {
      "id": "support_ma10",
      "name": "Support MA10",
      "direction": "bullish",
      "style": "green",
      "anchor_side": "bottom",
      "conditions": {
        "candle_color": "red",
        "wick_touch": { "field": "hL", "operator": "<=", "target": "m10" },
        "body_above_1": { "field": "hC", "operator": ">=", "target": "m10" },
        "body_above_2": { "field": "hO", "operator": ">=", "target": "m10" }
      },
      "confirm": { "next_bar_color": "green" },
      "trend_required": "bullish"
    },
    {
      "id": "signal_b",
      "name": "Signal B",
      "direction": "bearish",
      "style": "orange",
      "anchor_side": "top",
      "extends": "reject_ma10",
      "extra_conditions": {
        "break_below": { "field": "hC", "operator": "<=", "target": "m50" },
        "prev_above": { "field": "hO", "operator": ">", "target": "m50" },
        "space_m200": { "min_distance": 2.0 },
        "space_vw": { "min_distance": 1.0 }
      }
    }
  ],

  "entry_requirements": {
    "_comment": "这里只保留会直接影响进场点质量的条件。合约价格、仓位大小这类执行细节不纳入图表策略核心规则。",
    "pattern_required": true,
    "continuation_confirmation_required": true,
    "continuation_confirmation_bars_min": 1,
    "continuation_confirmation_bars_max": 2,
    "space_check_required": true,
    "do_not_enter_if_near_barrier_or_target": true,
    "directional_bias": "single_side_only",
    "description": "下单前先确认形态已出现、趋势确实延续一到两根 K，且前方没有贴近阻力位/目标位。"
  },

  "volume_validation": {
    "break_bar_volume_min": 5000,
    "follow_through_bars_required": 3,
    "follow_through_bar_volume_min": 2000,
    "purposes": [
      "filter_needles",
      "distinguish_expansion_vs_contraction",
      "confirm_breakout_is_not_single_print"
    ],
    "description": "单向 breakout 至少看到一根 >5000 volume，且连续三根 >2000，用来过滤插针并判断缩量/放量。"
  },

  "structure_playbooks": {
    "directional_intraday": {
      "follow_1m_ma": true,
      "require_volume_validation": true,
      "require_gex_check": true,
      "description": "盘中单向段只顺着方向做，不在 5m 趋势里反手。"
    },
    "range_intraday": {
      "follow_1m_ma": true,
      "require_volume_validation": true,
      "pivot_logic": {
        "repeated_reject_bounce_min_occurrences": 3,
        "pivot_definition": "midpoint_of_repeated_reject_and_bounce_zone",
        "width_definition": "distance_between_upper_reject_band_and_lower_bounce_band",
        "pivot_mid_can_be_used_as_risk_line": true
      },
      "monitoring": {
        "check_heat_map": true,
        "check_volume_wall": true,
        "watch_pivot_drift": true
      },
      "example_note": "可参考昨天 6880 的水泥墙。",
      "description": "震荡里通过多次 reject / bounce 找 pivot，中点就是 pivot，上下幅度就是 width。"
    }
  },

  "options_context": {
    "check_gex": true,
    "check_heat_map": true,
    "check_volume_wall": true,
    "pivot_may_change_with_wall": true,
    "description": "GEX / heat map / volume wall 主要用于确认方向是否还有墙体压制或支撑，以及 pivot 是否迁移。"
  },

  "scoring": {
    "enabled": true,
    "dimensions": {
      "trend_clarity":     { "max": 2, "desc": "趋势是否确认" },
      "entangle_distance": { "max": 2, "desc": "均线缠绕距离" },
      "vwap_alignment":    { "max": 1, "desc": "VWAP 方向一致" },
      "space_to_barrier":  { "max": 2, "desc": "目标方向空间" },
      "kline_quality":     { "max": 2, "desc": "K线实体/影线比" }
    },
    "max_total": 10
  },

  "profit_management": {
    "scale_out_required": true,
    "take_partial_once_plan_profit_is_reached": true,
    "allow_runner_after_partial": true,
    "accept_selling_too_early": true,
    "description": "分批止盈，到了一定盈利必须先出一部分；卖飞没事，先把利润锁住。"
  },

  "exit": {
    "_comment": "三层出场体系，优先级：L2 > L3 > L1。值为 0 或 null 表示关闭该层。",

    "L1_technical": {
      "tp_bars": 2,
      "tp_modulated_by_score": true,
      "time_stop_bars": 5,
      "ma_stop_line": "m10",
      "eod_close": "15:59"
    },

    "L2_hard_stops": {
      "spy_adverse_max": 0.50,
      "premium_sl_pct": 50,
      "premium_tp_pct": 80,
      "max_hold_minutes": 20
    },

    "L3_trailing": {
      "pullback_pct": 30,
      "activate_above_pct": 10
    }
  },

  "filter": {
    "min_score": 3,
    "session": { "start": "10:00", "end": "15:45" },
    "entangle_threshold": 0.12,
    "space_threshold": 0.30,
    "directional_break_volume_min": 5000,
    "confirmation_volume_min": 2000,
    "confirmation_volume_bars": 3
  },

  "hard_blocks": {
    "no_trend": true,
    "entangle": true,
    "no_space": true,
    "mtf_conflict": true,
    "countertrend_against_5m": true,
    "near_barrier": true,
    "no_pattern": true,
    "no_volume_confirmation": true
  },

  "options": {
    "default_iv": 0.22,
    "risk_free_rate": 0.045,
    "dte_mode": "auto",
    "dte_auto_switch": "14:00",
    "strike_method": "atm"
  }
}
