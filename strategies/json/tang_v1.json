{
  "name": "Tang v1",
  "version": "0.1",
  "description": "严格四线趋势 + MA10 止损 + 无评分",

  "trend": {
    "method": "strict",
    "timeframe": "5m",
    "description": "四线发散：MA10 > MA20 > MA50 > MA200 (bullish) 或反之 (bearish)",
    "lines": ["m10", "m20", "m50", "m200"]
  },

  "signals": [
    {
      "id": "reject_ma10",
      "name": "Reject MA10",
      "direction": "bearish",
      "style": "red",
      "anchor_side": "top",
      "conditions": {
        "candle_color": "green",
        "wick_touch": { "field": "hH", "operator": ">=", "target": "m10" },
        "body_below_1": { "field": "hC", "operator": "<=", "target": "m10" },
        "body_below_2": { "field": "hO", "operator": "<=", "target": "m10" }
      },
      "confirm": { "next_bar_color": "red" },
      "trend_required": "bearish"
    },
    {
      "id": "support_ma10",
      "name": "Support MA10",
      "direction": "bullish",
      "style": "green",
      "anchor_side": "bottom",
      "conditions": {
        "candle_color": "red",
        "wick_touch": { "field": "hL", "operator": "<=", "target": "m10" },
        "body_above_1": { "field": "hC", "operator": ">=", "target": "m10" },
        "body_above_2": { "field": "hO", "operator": ">=", "target": "m10" }
      },
      "confirm": { "next_bar_color": "green" },
      "trend_required": "bullish"
    }
  ],

  "scoring": {
    "enabled": false
  },

  "exit": {
    "tp_bars": 0,
    "time_stop_bars": 0,
    "ma_stop_line": "m10"
  },

  "filter": {
    "min_score": null,
    "session": { "start": "10:00", "end": "15:45" },
    "entangle_threshold": 0.30,
    "space_threshold": 0.50
  },

  "hard_blocks": {
    "no_trend": true,
    "entangle": true,
    "no_space": true
  }
}
