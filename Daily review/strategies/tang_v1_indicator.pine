//@version=5
indicator("小汤系统 - 终极完全体 (5m+1m+VWAP)", overlay=true)

// ==========================
// 1. 强制计算 1 分钟微观 HA 数据 (杜绝图表类型 Bug)
// ==========================
var float ha_open = na
ha_close = (open + high + low + close) / 4
ha_open := na(ha_open[1]) ? (open + close) / 2 : (ha_open[1] + ha_close[1]) / 2
ha_high = math.max(high, math.max(ha_open, ha_close))
ha_low = math.min(low, math.min(ha_open, ha_close))

// ==========================
// 2. 计算 1 分钟核心均线与 VWAP
// ==========================
ma10_1m = ta.sma(ha_close, 10)
ma50_1m = ta.sma(ha_close, 50)
ma200_1m = ta.sma(ha_close, 200)
vwap_1m = ta.vwap(close) // 调取当天的 VWAP 数据

plot(ma10_1m, color=color.new(#b86800, 0), title="1m MA10 (触发线)", linewidth=2)
plot(ma50_1m, color=color.new(#1a5090, 0), title="1m MA50 (防守关卡)", linewidth=2)
plot(ma200_1m, color=color.new(#187040, 0), title="1m MA200 (大关卡)", linewidth=2)
plot(vwap_1m, color=color.new(#6030a0, 0), title="1m VWAP (成交量关卡)", linewidth=2, style=plot.style_cross)

// ==========================
// 3. 后台侦测 5 分钟宏观大方向 (司令部)
// ==========================
// 强制获取 5 分钟级别的 平均K线(Heikin-Ashi) 数据
ha_ticker = ticker.heikinashi(syminfo.tickerid)

ma10_5m = request.security(ha_ticker, "5", ta.sma(close, 10))
ma20_5m = request.security(ha_ticker, "5", ta.sma(close, 20))
ma50_5m = request.security(ha_ticker, "5", ta.sma(close, 50))
ma200_5m = request.security(ha_ticker, "5", ta.sma(close, 200))

// 极其严苛的 5 分钟发散条件
bearish_trend_5m = (ma10_5m < ma20_5m) and (ma20_5m < ma50_5m) and (ma50_5m < ma200_5m)
bullish_trend_5m = (ma10_5m > ma20_5m) and (ma20_5m > ma50_5m) and (ma50_5m > ma200_5m)

// ==========================
// 4. 1 分钟 K 线状态判定
// ==========================
is_green = ha_close >= ha_open
is_red = ha_close < ha_open

// 抓取 Reject MA10
touch_ma10_up = ha_high >= ma10_1m
body_below_ma10 = ha_close <= ma10_1m and ha_open <= ma10_1m
reject_1m = is_green and touch_ma10_up and body_below_ma10

// 抓取 Support MA10
touch_ma10_down = ha_low <= ma10_1m
body_above_ma10 = ha_close >= ma10_1m and ha_open >= ma10_1m
support_1m = is_red and touch_ma10_down and body_above_ma10

// ==========================
// 5. 跨周期共振触发 (极低频，高胜率)
// ==========================
// 必须同时满足：5分钟大方向完美 + 1分钟精准测试均线 + 1分钟顺势确认
signal_put = bearish_trend_5m[1] and reject_1m[1] and is_red
signal_call = bullish_trend_5m[1] and support_1m[1] and is_green

// ==========================
// 6. 虚拟仓位与铁血止损
// ==========================
var int position = 0
if signal_call
    position := 1
if signal_put
    position := -1

condition_sl_put = is_green and ha_close > ma10_1m and ha_open > ma10_1m
condition_sl_call = is_red and ha_close < ma10_1m and ha_open < ma10_1m

// 只有在虚拟持仓的状态下，才会触发对应的止损报警
trigger_sl_put = position == -1 and condition_sl_put
trigger_sl_call = position == 1 and condition_sl_call

// 止损触发后，清空仓位状态
if trigger_sl_put or trigger_sl_call
    position := 0

// ==========================
// 7. 视觉绘制与报警系统
// ==========================
plotshape(signal_put, title="买入 PUT", style=shape.labeldown, location=location.abovebar, color=color.new(#9e2a1a, 0), size=size.small, text="PUT", textcolor=color.white)
plotshape(signal_call, title="买入 CALL", style=shape.labelup, location=location.belowbar, color=color.new(#1d7a4a, 0), size=size.small, text="CALL", textcolor=color.white)

plotshape(trigger_sl_put, title="PUT 止损", style=shape.xcross, location=location.abovebar, color=color.new(#ffeb3b, 0), size=size.normal)
plotshape(trigger_sl_call, title="CALL 止损", style=shape.xcross, location=location.belowbar, color=color.new(#ffeb3b, 0), size=size.normal)

// 弹窗警报
alertcondition(signal_put, title="做空共振", message="5分钟空头排列 + 1分钟 Reject MA10 确认！注意检查下方 VWAP 空间！")
alertcondition(signal_call, title="做多共振", message="5分钟多头排列 + 1分钟 Support MA10 确认！注意检查上方 VWAP 空间！")
alertcondition(trigger_sl_put, title="空单止损", message="绿K实体突破 1m MA10，立刻撤退！")
alertcondition(trigger_sl_call, title="多单止损", message="红K实体跌破 1m MA10，立刻撤退！")