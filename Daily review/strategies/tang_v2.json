{
  "name": "Tang v2",
  "version": "0.2",
  "description": "放宽趋势 + 信号评分 + 三级出场",

  "trend": {
    "method": "relaxed",
    "timeframe": "5m",
    "description": "MA10 vs MA50 方向 + MA10 斜率 (3-bar lookback)",
    "fast_ma": "m10",
    "slow_ma": "m50",
    "slope_bars": 3
  },

  "signals": [
    {
      "id": "reject_ma10",
      "name": "Reject MA10",
      "direction": "bearish",
      "style": "red",
      "anchor_side": "top",
      "conditions": {
        "candle_color": "green",
        "wick_touch": { "field": "hH", "operator": ">=", "target": "m10" },
        "body_below_1": { "field": "hC", "operator": "<=", "target": "m10" },
        "body_below_2": { "field": "hO", "operator": "<=", "target": "m10" }
      },
      "confirm": { "next_bar_color": "red" },
      "trend_required": "bearish"
    },
    {
      "id": "support_ma10",
      "name": "Support MA10",
      "direction": "bullish",
      "style": "green",
      "anchor_side": "bottom",
      "conditions": {
        "candle_color": "red",
        "wick_touch": { "field": "hL", "operator": "<=", "target": "m10" },
        "body_above_1": { "field": "hC", "operator": ">=", "target": "m10" },
        "body_above_2": { "field": "hO", "operator": ">=", "target": "m10" }
      },
      "confirm": { "next_bar_color": "green" },
      "trend_required": "bullish"
    },
    {
      "id": "signal_b",
      "name": "Signal B",
      "direction": "bearish",
      "style": "orange",
      "anchor_side": "top",
      "extends": "reject_ma10",
      "extra_conditions": {
        "break_below": { "field": "hC", "operator": "<=", "target": "m50" },
        "prev_above": { "field": "hO", "operator": ">", "target": "m50" },
        "space_m200": { "min_distance": 2.0 },
        "space_vw": { "min_distance": 1.0 }
      }
    }
  ],

  "scoring": {
    "enabled": true,
    "dimensions": {
      "trend_clarity":     { "max": 2, "desc": "趋势是否确认", "rule": "trend_exists ? 2 : 0" },
      "entangle_distance": { "max": 2, "desc": "均线缠绕距离", "rule": "margin > 0.5 ? 2 : margin > 0 ? 1 : 0" },
      "vwap_alignment":    { "max": 1, "desc": "VWAP 方向一致", "rule": "vwap_aligned ? 1 : 0" },
      "space_to_barrier":  { "max": 2, "desc": "目标方向空间", "rule": "space > 2.0 ? 2 : space > threshold ? 1 : 0" },
      "kline_quality":     { "max": 2, "desc": "K线实体/影线比", "rule": "body_ratio > 0.7 ? 2 : body_ratio > 0.4 ? 1 : 0" }
    },
    "max_total": 10
  },

  "exit": {
    "tp_bars": 2,
    "time_stop_bars": 5,
    "ma_stop_line": "m10"
  },

  "filter": {
    "min_score": 3,
    "session": { "start": "10:00", "end": "15:45" },
    "entangle_threshold": 0.12,
    "space_threshold": 0.30
  },

  "hard_blocks": {
    "no_trend": true,
    "entangle": true,
    "no_space": true
  }
}
