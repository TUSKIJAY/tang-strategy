{
  "name": "Tang v3.5.1 Full",
  "version": "3.5.1",
  "description": "由 Downloads/message (2).txt 转换：HA 用于颜色与影线判定，均线/VWAP/止损使用普通价格以对齐券商；5m MA10/20/30 顺势过滤；0.15% 空间检测；影线多线共振分级；MA50 实体贯穿止损。",

  "source": {
    "type": "tradingview_pine",
    "pine_version": 5,
    "indicator_title": "小汤系统 V3.5.1 - 完整非压缩版",
    "source_file": "Downloads/message (2).txt",
    "overlay": true
  },

  "candles": {
    "type": "heikin_ashi_for_signal_shape",
    "price_alignment": "broker_close_for_ma_vwap_and_stop",
    "fields": {
      "hC": "(open + high + low + close) / 4",
      "hO": "first_bar ? (open + close) / 2 : (prior_hO + prior_hC) / 2",
      "hH": "max(high, hO, hC)",
      "hL": "min(low, hO, hC)"
    },
    "color_rules": {
      "green": "hC > hO",
      "red": "hC < hO"
    }
  },

  "indicators": {
    "moving_averages": {
      "m10": { "type": "sma", "source": "close", "length": 10, "role": "trigger_line" },
      "m20": { "type": "sma", "source": "close", "length": 20, "role": "short_defense" },
      "m30": { "type": "sma", "source": "close", "length": 30, "role": "secondary_defense" },
      "m50": { "type": "sma", "source": "close", "length": 50, "role": "bull_bear_boundary" },
      "m200": { "type": "sma", "source": "close", "length": 200, "role": "life_death_line" }
    },
    "vwap": {
      "id": "vw",
      "type": "vwap",
      "source": "close",
      "role": "institutional_level"
    }
  },

  "trend": {
    "method": "regular_close_5m_ma_stack",
    "timeframe": "5m",
    "description": "使用普通 close 计算 5m MA10/MA20/MA30；只有 10>20>30 才是真多头，10<20<30 才是真空头。",
    "lines": ["m10", "m20", "m30"],
    "bullish": {
      "m10_above_m20": { "field": "m10_5m", "operator": ">", "target": "m20_5m" },
      "m20_above_m30": { "field": "m20_5m", "operator": ">", "target": "m30_5m" }
    },
    "bearish": {
      "m10_below_m20": { "field": "m10_5m", "operator": "<", "target": "m20_5m" },
      "m20_below_m30": { "field": "m20_5m", "operator": "<", "target": "m30_5m" }
    }
  },

  "multi_timeframe": {
    "primary_bias_tf": "5m",
    "execution_tf": "1m",
    "higher_tf_priority": true,
    "trend_required_for_signal": true,
    "description": "PUT 必须 5m 三线空头排列；CALL 必须 5m 三线多头排列。"
  },

  "confluence": {
    "enabled": true,
    "method": "wick_touch_count_only",
    "levels": ["m10", "m20", "m30", "m50", "vw"],
    "excluded_levels": ["m200"],
    "reject_rule": {
      "wick_touch": { "field": "hH", "operator": ">=", "target": "level" }
    },
    "support_rule": {
      "wick_touch": { "field": "hL", "operator": "<=", "target": "level" }
    },
    "put_score": "sum(hH >= m10,m20,m30,m50,vw)",
    "call_score": "sum(hL <= m10,m20,m30,m50,vw)",
    "normal_threshold": 1,
    "strong_threshold_min": 2,
    "description": "V3.5.1 的共振计数只看 HA 影线是否触及对应线，不再要求实体仍在线下/线上，也不计入 MA200。"
  },

  "signals": [
    {
      "id": "reject_ma10",
      "name": "Reject MA10 Setup",
      "direction": "bearish",
      "style": "red",
      "anchor_side": "top",
      "conditions": {
        "previous_candle_color": "green",
        "previous_wick_touch": { "field": "hH[1]", "operator": ">=", "target": "m10[1]" },
        "previous_close_below": { "field": "hC[1]", "operator": "<=", "target": "m10[1]" }
      },
      "confirm": { "current_bar_color": "red" },
      "trend_required": "bearish"
    },
    {
      "id": "support_ma10",
      "name": "Support MA10 Setup",
      "direction": "bullish",
      "style": "green",
      "anchor_side": "bottom",
      "conditions": {
        "previous_candle_color": "red",
        "previous_wick_touch": { "field": "hL[1]", "operator": "<=", "target": "m10[1]" },
        "previous_close_above": { "field": "hC[1]", "operator": ">=", "target": "m10[1]" }
      },
      "confirm": { "current_bar_color": "green" },
      "trend_required": "bullish"
    },
    {
      "id": "put_normal",
      "name": "Normal PUT",
      "direction": "bearish",
      "style": "red",
      "anchor_side": "top",
      "extends": "reject_ma10",
      "conditions": {
        "setup": "reject_ma10",
        "current_bar_color": "red",
        "trend_5m": "bearish",
        "can_trade": "put",
        "prev_rej_score": { "operator": "<", "value": 2 }
      },
      "label": {
        "text": "PUT",
        "size": "small",
        "color": "#c62828",
        "text_color": "#ffffff"
      }
    },
    {
      "id": "put_strong",
      "name": "Strong PUT",
      "direction": "bearish",
      "style": "orange",
      "anchor_side": "top",
      "extends": "reject_ma10",
      "conditions": {
        "setup": "reject_ma10",
        "current_bar_color": "red",
        "trend_5m": "bearish",
        "can_trade": "put",
        "prev_rej_score": { "operator": ">=", "value": 2 }
      },
      "label": {
        "text": "Strong PUT",
        "prefix": "flame",
        "size": "normal",
        "color": "#d84315",
        "text_color": "#ffffff"
      }
    },
    {
      "id": "call_normal",
      "name": "Normal CALL",
      "direction": "bullish",
      "style": "green",
      "anchor_side": "bottom",
      "extends": "support_ma10",
      "conditions": {
        "setup": "support_ma10",
        "current_bar_color": "green",
        "trend_5m": "bullish",
        "can_trade": "call",
        "prev_sup_score": { "operator": "<", "value": 2 }
      },
      "label": {
        "text": "CALL",
        "size": "small",
        "color": "#2e7d32",
        "text_color": "#ffffff"
      }
    },
    {
      "id": "call_strong",
      "name": "Strong CALL",
      "direction": "bullish",
      "style": "teal",
      "anchor_side": "bottom",
      "extends": "support_ma10",
      "conditions": {
        "setup": "support_ma10",
        "current_bar_color": "green",
        "trend_5m": "bullish",
        "can_trade": "call",
        "prev_sup_score": { "operator": ">=", "value": 2 }
      },
      "label": {
        "text": "Strong CALL",
        "prefix": "flame",
        "size": "normal",
        "color": "#00695c",
        "text_color": "#ffffff"
      }
    }
  ],

  "entry_requirements": {
    "pattern_required": true,
    "continuation_confirmation_required": true,
    "confirmation_bar_source": "current_bar_after_prior_setup",
    "space_check_required": true,
    "space_threshold_pct": 0.15,
    "trend_required": true,
    "not_tangled_required": true,
    "description": "上一根 HA K 线在 MA10 形成反抽受阻或回踩企稳，当前 K 线变色确认，同时 5m 顺势、非缠绕、目标方向到最近 MA50/MA200/VWAP 至少有 0.15% 空间。"
  },

  "space_check": {
    "enabled": true,
    "min_distance_pct_of_price": 0.15,
    "threshold_formula": "close * 0.0015",
    "call_barriers_above": ["m50", "m200", "vw"],
    "put_barriers_below": ["m50", "m200", "vw"],
    "call_rule": "nearest upper m50/m200/vw - close >= close * 0.0015",
    "put_rule": "close - nearest lower m50/m200/vw >= close * 0.0015",
    "barrier_source": "regular_close_based_levels"
  },

  "scoring": {
    "enabled": true,
    "type": "wick_touch_confluence",
    "dimensions": {
      "ma10_touch": { "max": 1, "desc": "HA 影线触及 MA10" },
      "ma20_touch": { "max": 1, "desc": "HA 影线触及 MA20" },
      "ma30_touch": { "max": 1, "desc": "HA 影线触及 MA30" },
      "ma50_touch": { "max": 1, "desc": "HA 影线触及 MA50" },
      "vwap_touch": { "max": 1, "desc": "HA 影线触及 VWAP" }
    },
    "normal_signal_score_max": 1,
    "strong_signal_score_min": 2,
    "max_total": 5
  },

  "position_state": {
    "enabled": true,
    "virtual_position": true,
    "set_short_on": "signal_put",
    "set_long_on": "signal_call",
    "reset_on_stop": true
  },

  "exit": {
    "_comment": "V3.5.1 只实现 MA50 实体贯穿止损，且止损使用普通 open/close 对齐券商价格。",
    "L1_technical": {
      "tp_bars": 0,
      "time_stop_bars": 0,
      "ma_stop_line": "m50"
    },
    "L2_hard_stops": {
      "catastrophic_ma50_body_cross": true,
      "price_source": "regular_open_close",
      "put_stop": {
        "close_above_m50": { "field": "close", "operator": ">", "target": "m50" },
        "open_below_m50": { "field": "open", "operator": "<", "target": "m50" }
      },
      "call_stop": {
        "close_below_m50": { "field": "close", "operator": "<", "target": "m50" },
        "open_above_m50": { "field": "open", "operator": ">", "target": "m50" }
      }
    },
    "L3_trailing": {
      "enabled": false
    }
  },

  "filter": {
    "min_score": null,
    "session": {
      "start": "09:30",
      "end": null,
      "timezone": "America/New_York",
      "source_note": "源码注释写 10:00 AM 之后才工作，但表达式实际为 hour >= 10 或 09:30 后，因此允许 09:30 以后。"
    },
    "entangle_threshold": 0.03,
    "entangle_threshold_ratio": 0.0003,
    "entangle_lines": ["m10", "m20", "m30", "m50"],
    "entangle_source": "regular_close_based_mas",
    "space_threshold": 0.15,
    "space_threshold_ratio": 0.0015
  },

  "hard_blocks": {
    "no_trend": true,
    "entangle": true,
    "no_space": true,
    "mtf_conflict": true,
    "before_session_start": true
  },

  "alerts": [],

  "options": {
    "default_iv": 0.22,
    "risk_free_rate": 0.045,
    "dte_mode": "auto",
    "dte_auto_switch": "14:00",
    "strike_method": "atm"
  }
}
